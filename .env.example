# Local development default: file-based SQLite (no server / network required).
# DATABASE_URL is required by the app — there is no silent fallback.
DATABASE_URL=sqlite:///./aidtip.db

# Production (Render + Neon) example:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Comma-separated browser origins allowed by CORS (add Vercel URL in production).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

LOG_LEVEL=INFO
RULES_CONFIG_PATH=backend/config/rules.yaml
PCAP_PATH=samples/sample.pcap
CAPTURE_INTERFACE=eth0

# Optional — only used if you later run local Docker Compose Postgres.
POSTGRES_USER=aidtip
POSTGRES_PASSWORD=aidtip
POSTGRES_DB=aidtip
